# Copy to .env if you want to override config/settings.yaml.
# Leave these placeholders until you have a real provider key.
# Do not commit a filled-in .env.

SEPSISGUARD_LLM_API_KEY=YOUR_LLM_API_KEY_HERE
SEPSISGUARD_LLM_BASE_URL=https://YOUR_LLM_BASE_URL_HERE/v1
SEPSISGUARD_LLM_MODEL=YOUR_LLM_MODEL_HERE

# Optional provider-specific keys (all placeholders)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY_HERE
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
