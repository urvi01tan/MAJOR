# Copy this file to .env if you want to override config/settings.yaml
# Example:
#   SEPSISGUARD_LLM_PROVIDER=gemini
#   GEMINI_API_KEY=your_gemini_api_key_here

SEPSISGUARD_LLM_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
SEPSISGUARD_LLM_API_KEY=YOUR_GEMINI_API_KEY_HERE
SEPSISGUARD_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
SEPSISGUARD_LLM_MODEL=gemini-2.5-flash

# Optional alternative providers:
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
# AZURE_OPENAI_API_KEY=your_azure_key_here
